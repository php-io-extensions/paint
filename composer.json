{
    "name": "php-io-extensions/paint",
    "type": "php-ext",
    "description": "Shapes painted straight into pixels in C: PaintSurface fills paths, ellipses, rounded boxes, shadows and thin lines, in a colour or a gradient",
    "keywords": [
        "paint",
        "2d",
        "rasterizer",
        "blend",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "paint",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-paint",
                "description": "Enable the paint extension",
                "needs-value": false
            }
        ]
    }
}
